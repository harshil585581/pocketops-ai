# Firebase web app config (console → Project settings → Your apps → Web app).
# These values are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Gemini models (Remote Config `cloud_model` / `deep_model` override these at runtime).
# Quick answers use a fast model; Deep analysis uses a more capable one and falls back to the fast one if it's busy.
VITE_GEMINI_MODEL=gemini-flash-lite-latest
VITE_GEMINI_DEEP_MODEL=gemini-3.8-flash

# Firebase App Check — required by Firebase AI Logic.
# reCAPTCHA Enterprise site key: console → App Check → Apps → your web app.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Debug token, used by `npm run dev` only (stripped from production builds) (App Check → Apps → ⋮ → Manage debug tokens).
# This one IS a secret: keep it in .env, never commit it.
VITE_APPCHECK_DEBUG_TOKEN=
